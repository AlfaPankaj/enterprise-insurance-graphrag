# ---------------------------------------------------------------------------
# GraphRAG Insurance Claims System — environment template (v2)
# Copy to `.env` and fill in. NEVER commit `.env` or real credentials.
# Every value has a documented default in src/graphrag/config.py.
# ---------------------------------------------------------------------------

# --- Neo4j (AuraDB or self-managed) ---
# AuraDB example:  neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-strong-password

# --- LLM provider (v2 multi-provider layer) ---
# LLM_PROVIDER: auto | ollama | openai
#   auto = try OpenAI-compatible when configured, else Ollama, else extractive
LLM_PROVIDER=auto
# OpenAI-compatible endpoint (Azure OpenAI, vLLM, Together, Groq, …)
# Azure example: https://<resource>.openai.azure.com/openai/deployments/<deployment>
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_VERSION=
ANSWER_MODEL=

# Local Ollama (dev / air-gapped fallback)
LLAMA_API_URL=http://localhost:11434
LLAMA_MODEL=llama3.2:3b

# --- API auth (v2 identity & RBAC) ---
# AUTH_MODE: none | static | jwt
#   none   = dev only, no auth (DO NOT use in production)
#   static = single API key; API_KEY_ROLES can grant e.g. "admin,analyst"
#   jwt    = OIDC / JWT verification
AUTH_MODE=none
API_KEY=
API_KEY_ROLES=admin,analyst,auditor
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
# Leave JWKS_URL empty to verify HS256 with JWT_SECRET; set it for RS256
JWKS_URL=

# --- Trust & compliance (v2) ---
# PII_MODE: off | mask — mask redacts PII-classified fields in retrieval
# context and answers for callers whose role lacks pii.read
PII_MODE=off
# PII at rest: set a key to Fernet-encrypt PII-classified fields before they
# are written to Neo4j (decrypted on read). Generate one with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PII_ENCRYPTION_KEY=
GUARDRAILS_ENABLED=false
# TENANT_MODE: off | column — column scopes every graph query by tenant_id
TENANT_MODE=off

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8502
RATE_LIMIT_PER_MINUTE=60
TRUST_PROXY_FORWARDED_FOR=false

# --- Retrieval & token optimization ---
MAX_HOPS=2
MAX_TOKENS=1280
TOP_K=50
RERANKER_MODE=auto
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Audit trail ---
AUDIT_ENABLED=true
AUDIT_DIR=data/audit_trail
AUDIT_MAX_RECORDS=2000

# --- v2: answer cache (WS-A) ---
# Cache keys bind query + pipeline params + tenant + PII scope + dataset
# revision (any graph write bumps the revision -> automatic invalidation).
CACHE_ENABLED=false
CACHE_TTL_S=300
CACHE_MAX_ENTRIES=1000

# --- v2: observability & jobs (WS-A/WS-D) ---
# OpenTelemetry: pip install -r requirements-otel.txt, then enable +
# point at any OTLP collector (Jaeger/Tempo/Datadog/New Relic):
TRACING_ENABLED=false
TRACING_OTLP_ENDPOINT=

# Durable background jobs (session switch / benchmarks) stored in SQLite:
JOB_DB_PATH=data/jobs.db
